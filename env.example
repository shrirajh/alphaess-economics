# AlphaESS API Credentials
ALPHAESS_APP_ID=your-app-id-here
ALPHAESS_APP_SECRET=your-app-secret-here

# NMI (National Meter Identifier)
NMI=your-nmi-here

# System Serial Number (get from getESSList if you don't know it)
SYSTEM_SN=your-system-serial-number

# Electricity Rates ($ per kWh)
RATE_PEAK=0.4905
RATE_OFFPEAK=0.3362
RATE_SHOULDER=0.2875
FEED_IN_TARIFF=0.06

# Battery Cost Analysis (for future purchase projections)
BATTERY_COST_PER_10KWH=10000
BATTERY_LIFESPAN_YEARS=10

# Your Actual Installation Costs (for retrospective ROI)
# What you actually paid for your existing system
PANEL_SUNK_COST=5000
BATTERY_SUNK_COST=11000

# Data Fetching Config
# Stop fetching historical data after this many consecutive days with no data
MAX_EMPTY_DAYS=30
